# --- GSD runtime / local state (keep the shareable install + planning docs, ignore local artifacts) ---
# .planning/ is tracked (commit_docs=Yes); ignore only noisy runtime traces within it
.planning/.gsd-trace.jsonl
.planning/ui-reviews/
.claude/.gsd-staging/
.claude/gsd-install-state.json

# --- Python (backend) ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
backend/data/

# --- Node (extension / tooling) ---
node_modules/
npm-debug.log*
yarn-error.log*

# --- Env / secrets ---
.env
.env.*
!.env.example

# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# GSD research-store cache (per-run)
.planning/research/.cache/
.planning/**/.cache/
